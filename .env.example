# ========================================================
# Sahaay AI — Environment Configuration
# ========================================================

# Server Port
PORT=3001

# Allowed Frontend Origin
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# If left empty, Sahaay AI automatically operates in Demonstration Mode with verified heuristics.
GEMINI_API_KEY=

# Gemini Model Identifier
# Configurable model name (e.g., gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Frontend API Base URL (leave empty for Vite development proxy)
VITE_API_BASE_URL=
